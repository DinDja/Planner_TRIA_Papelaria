[debug] [2026-08-30T01:25:02.338Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/teste-3637d/rulesets {"name":"projects/teste-3637d/rulesets/55638c6b-eed7-4f50-bb97-782bdebd2b9f","source":{"files":[{"content":"rules_version = '2';\n\r\n// ─────────────────────────────────────────────────────────────────────────────\r\n// PlannerHub — Firestore Security Rules\r\n//\r\n// Modelo de dados: multi-tenant estrito por usuário. Toda collection vive em\r\n// /users/{uid}/... e só o dono do uid pode ler/escrever. Não há collections\r\n// globais compartilhadas (o produto hoje é single-user, sem features sociais ou\r\n// colaborativas).\r\n//\r\n// Convenções:\r\n//   - timestamps são strings ISO 8601 (UTC) enviadas pelo cliente. As regras só\r\n//     validam que sejam strings quando presentes; não tentam forçar\r\n//     serverTimestamp() — isso simplifica o cliente e mantém as regras\r\n//     auditáveis. O risco de clock skew é mitigado em camada de app.\r\n//   - validação é estrutural (tipos e propriedade), não comportamental. Regras\r\n//     de negócio (ex.: amount > 0,deadline > startDate) vivem no cliente.\r\n//   - arrays embutidos só para filhos pequenos e vinculados a um único pai no\r\n//     domínio (items de checklist/lista, actions de retro). O resto vira\r\n//     subcollection porque páginas de planner crescem sem born.\r\n// ─────────────────────────────────────────────────────────────────────────────\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // ─── Helpers ────────────────────────────────────────────────────────────\r\n    function isSignedIn() {\r\n      return request.auth != null && request.auth.uid != null;\r\n    }\r\n\r\n    // Dono do documento sob /users/{uid}/... — o uid do path precisa casar com\r\n    // o uid autenticado. Toda regra abaixo reusa isto.\r\n    function owns(uid) {\r\n      return isSignedIn() && request.auth.uid == uid;\r\n    }\r\n\r\n    // Admina: usuário cujo doc-raiz tem `role == 'admin'`. A role é\r\n    // derivada do e-mail no cadastro (seed.ts) e imutável por update da\r\n    // própria usuária (regra mais abaixo bloqueia mudança de `role`).\r\n    function isAdmin() {\r\n      return isSignedIn()\r\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\r\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\r\n    }\r\n\r\n    // Valida que `value` é uma string timestamp ISO 8601 (heurística leve).\r\n    // Aceita tanto \"2026-07-24T…\" quanto \"2026-07-24\". Regras não podem\r\n    // rodar regex com / multa complexa sem estourar custo, então conferimos\r\n    // os dígitos essenciais.\r\n    function isTimestampString(value) {\r\n      return value is string && value.size() >= 10;\r\n    }\r\n\r\n    // Valida um id curto gerado pelo cliente (ex.: \"pl-abc12345\").\r\n    function isIdString(value) {\r\n      return value is string && value.size() > 0 && value.size() <= 64;\r\n    }\r\n\r\n    // true quando field está ausente OU é do tipo esperado.\r\n    function optionalString(value) { return !('field' in value) || value is string; }\r\n    function optionalBool(value)   { return !('field' in value) || value is bool; }\r\n    function optionalNum(value)    { return !('field' in value) || value is number; }\r\n    function optionalStr(value)   { return !('field' in value) || value is string; }\r\n    function optionalArr(value)   { return !('field' in value) || value is list; }\r\n    function optionalMap(value)   { return !('field' in value) || value is map; }\r\n\r\n    // ─── Raiz: usuário ───────────────────────────────────────────────────────\r\n    // /users/{uid}                -> documento-raiz (perfil + prefs + settings + health-profile)\r\n    //\r\n    // Subcollections diretas:\r\n    //   diarios, planners, plannerPages, noteFolders (não — embed no root),\r\n    //   notes, shoppingLists, checklists, quotes, memories, passwords, wishlist,\r\n    //   weightRecords, bodyMeasurements, symptomLogs, medications, cycleRecords,\r\n    //   doctors, appointments, exams, habits, habitLogs, tasks, recurringTasks,\r\n    //   pendingItems, routineSlots, calendarEvents, financialAccounts, transactions, fixedBills,\n    //   subscriptions, creditCards, installments, financialGoals, goalDeposits,\r\n    //   savingsBoxes, retroEntries, trashItems\r\n    //\r\n    // Note: noteFolders? Not embedded — kept as folders field on root doc\r\n    // (it's small, single-ownership, widely read).\r\n    // ----------------------------------------------------------------------\r\n\r\n    match /users/{uid} {\r\n      // ── Documento-raiz do usuário ───────────────────────────────────────\r\n      // Esquema (mapeia useProfileStore + useSettingsStore + escalar de useHealthStore):\r\n      //   name        : string\r\n      //   avatar      : string        // emoji avatar\r\n      //   email       : string\r\n      //   role        : string        // 'admin' | 'subscriber'  (definido no seed)\r\n      //   subscription: map           // { role, plan, status, since, lastPayment }\r\n      //   blocked     : bool          // se true, login barrado no cliente\r\n      //   settings    : map            // SystemSettings\r\n      //   theme         : string       // 'light' | 'dark'\n      //   diarioPasswordHash : string  // hash SHA-256 da senha do Diário\n      //   folders       : list         // Planner folders [{id,name,color}]\n      //   plannerTags   : list         // Planner tags  [{id,name,color}]\r\n      //   noteFolders   : list         // Notes folders  [{id,name,color,icon?}]\r\n      //   updatedAt     : string ISO\r\n      // Leitura: só a própria usuária OU admina.\r\n      allow read: if owns(uid) || isAdmin();\r\n      allow create: if owns(uid)\r\n        && request.resource.data.name is string\r\n        && request.resource.data.avatar is string\r\n        && request.resource.data.email is string\r\n        && (!('role' in request.resource.data) || request.resource.data.role is string)\r\n        && (!('settings' in request.resource.data) || request.resource.data.settings is map)\r\n        && (!('folders' in request.resource.data) || request.resource.data.folders is list)\r\n        && (!('plannerTags' in request.resource.data) || request.resource.data.plannerTags is list)\r\n        && (!('noteFolders' in request.resource.data) || request.resource.data.noteFolders is list);\r\n      // Update: própria usuária pode atualizar tudo EXCETO `role` e `blocked`\r\n      // (esses campos só a admina mexe). Admina pode atualizar qualquer campo\r\n      // no doc de outra usuária.\r\n      allow update: if (owns(uid) && !(\r\n          ('role' in request.resource.data.diff(resource.data).affectedKeys())\r\n          || ('blocked' in request.resource.data.diff(resource.data).affectedKeys())\r\n        )) || isAdmin();\r\n      allow delete: if owns(uid);\r\n\r\n      // ─── Planners (useAppStore) ─────────────────────────────────────────\r\n      // /users/{uid}/planners/{plannerId}\r\n      // Esquema:\r\n      //   id, name, description?, category, color, icon, favorite, folderId|null,\r\n      //   tags: list<string>, createdAt, updatedAt,\r\n      //   pages?: list          // LEGADO: pode existir se importado de localStorage,\r\n      //                         // mas a fonte canonical passa a ser /plannerPages.\r\n      //                         // As regras aceitam ambos (com e sem pages).\r\n      match /planners/{plannerId} {\r\n        allow read, write: if owns(uid);\r\n\r\n        // Páginas de planner — subcollection para evitar estouro do 1MB doc.\r\n        // /users/{uid}/planners/{plannerId}/pages/{pageId}\r\n        //   id, title, template, data: map (CanvasData), updatedAt?\r\n        // CanvasData: strokes[], stickers[], texts[], shapes[], stickyNotes[], bgColor?\r\n        match /pages/{pageId} {\r\n          allow read, write: if owns(uid);\r\n        }\r\n      }\r\n\r\n      // ─── Diário Digital (useDiarioStore — V2, unificado) ────────────────\r\n      // /users/{uid}/diarios/{diarioId}\r\n      //   id, periodo: 'dia'|'semana'|'mes', data, dataFim?,\r\n      //   criadoEm, atualizadoEm, titulo?, emocoes: list<string>, energia: int 1..5,\r\n      //   cor, tags: list<string>, rabisco?: list<map>, fixado?: bool,\r\n      //   momento?: 'madrugada'|'manha'|'tarde'|'anoitecer'|'noite',\r\n      //   prompt?: string, texto?: string,\r\n      //   retro?: map { fora: list<string>, dentro: list<string>, proximo: list<string> },\r\n      //   notas?: string\r\n      match /diarios/{diarioId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Journal (useJournalStore — legado, mantido p/ migração) ────────\r\n      // /users/{uid}/journalEntries/{entryId}\r\n      //   id, title, content, date, timeOfDay, mood: map { emotions, energy, note? },\r\n      //   prompt?, tags: list<string>, color, createdAt, updatedAt, pinned?, drawing?\r\n      match /journalEntries/{entryId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Retrospectiva (useRetroStore — legado, mantido p/ migração) ───\r\n      // /users/{uid}/retroEntries/{entryId}\r\n      //   id, type: 'daily'|'weekly'|'monthly', date, endDate?, mood: string,\r\n      //   wentWell: list, toImprove: list, actions: list<map>,\r\n      //   notes?, createdAt\r\n      match /retroEntries/{entryId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Notas (useNotesStore) ──────────────────────────────────────────\r\n      // /users/{uid}/notes/{noteId}\r\n      //   id, title, content, folderId|null, tags: list<string>,\r\n      //   color, pinned: bool, createdAt, updatedAt\r\n      match /notes/{noteId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Listas (useListsStore) ─ items embutidos ───────────────────────\r\n      // /users/{uid}/shoppingLists/{listId}\r\n      //   id, name, color, kind?: 'supermercado'|'farmacia'|'mala'|'custom',\r\n      //   items: list<map { id, name, quantity?, category?, checked, dosage?,\r\n      //   packed?, notes?, createdAt }>, createdAt, updatedAt\r\n      match /shoppingLists/{listId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // /users/{uid}/listPresets/{presetId}   — itens \"prontos para usar\"\r\n      //   cadastrados pelo próprio usuário (id, kind, name, quantity?,\r\n      //   category?, dosage?)\r\n      match /listPresets/{presetId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Checklists (useChecklistsStore) ─ items embutidos ─────────────\r\n      // /users/{uid}/checklists/{checklistId}\r\n      //   id, title, color, items: list<map { id, text, checked, createdAt }>,\r\n      //   createdAt, updatedAt\r\n      match /checklists/{checklistId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Frases (useQuotesStore) ───────────────────────────────────────\r\n      // /users/{uid}/quotes/{quoteId}\r\n      //   id, text, author?, tags: list<string>, color, createdAt\r\n      match /quotes/{quoteId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Caixa de memórias (useMemoriesStore) ──────────────────────────\r\n      // /users/{uid}/memories/{memoryId}\r\n      //   id, title, description, date, mood: 'great'|'good'|'neutral'|'bad'|'tough',\r\n      //   tags: list<string>, color, createdAt\r\n      match /memories/{memoryId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Cofre de senhas (usePasswordsStore) ───────────────────────────\r\n      //   ⚠️ ATENÇÃO: armazenar segredes em plaintext no Firestore não é recomendado\r\n      // para produção. O cliente hoje guarda `masterPin` em localStorage; o schema\r\n      // abaixo é o espelho fiel, mas antes de ir a prod:\r\n      //     • troque `password` por um blob cifrado no cliente (Crypto Web, AES-GCM)\r\n      //     • nunca confie em `masterPin` em texto; derive via Argon2/bcrypt server-side\r\n      // The rules below allow the field to exist as string (backward-compat) but the\r\n      // only safety control is per-user ownership — assume at-rest encryption at app layer.\r\n      // /users/{uid}/passwords/{passwordId}\r\n      //   id, title, username?, password, url?, category?, notes?, color, createdAt, updatedAt\r\n      match /passwords/{passwordId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Wishlist (useWishlistStore) ───────────────────────────────────\r\n      // /users/{uid}/wishlist/{itemId}\r\n      //   id, name, store?, url?, price?, priority: 'low'|'medium'|'high',\r\n      //   category?, notes?, purchased, purchasedAt?, createdAt, updatedAt\r\n      match /wishlist/{itemId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Aniversários (useBirthdaysStore) ───────────────────────────────\r\n      // /users/{uid}/birthdays/{birthdayId}\r\n      //   id, name, date (YYYY-MM-DD), notes?, color, createdAt\r\n      match /birthdays/{birthdayId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Saúde (useHealthStore) ─ 8 subcollections ──────────────────────\r\n      // /users/{uid}/weights/{recordId}\r\n      //   id, date, weight: number (kg), notes?, createdAt\r\n      match /weights/{recordId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/bodyMeasurements/{recordId}\r\n      //   id, date, bust?, waist?, abdomen?, hips?, arm?, thigh?, calf?, notes?, createdAt\r\n      match /bodyMeasurements/{recordId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/symptomLogs/{recordId}\r\n      //   id, date, symptom, time?: 'HH:mm', possibleCause?,\r\n      //   severity: int 1..5, notes?, createdAt\r\n      match /symptomLogs/{recordId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/medications/{recordId}\r\n      //   id, name, dosage, frequency, times?: list<string>, startDate,\r\n      //   endDate?, reason?, notes?, color, createdAt\r\n      match /medications/{recordId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/cycleRecords/{recordId}\r\n      //   id, startDate, endDate?, flow: 'light'|'medium'|'heavy',\r\n      //   symptoms: list<string>, notes?, createdAt\r\n      match /cycleRecords/{recordId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/doctors/{doctorId}\r\n      //   id, name, specialty, phone?, email?, address?, notes?, color, createdAt\r\n      match /doctors/{doctorId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/appointments/{appointmentId}\r\n      //   id, doctorId?, doctorName, specialty, date, time, whatToBring?,\r\n      //   questions?, location?, notes?, status: 'scheduled'|'done'|'cancelled',\r\n      //   createdAt\r\n      match /appointments/{appointmentId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/exams/{examId}\r\n      //   id, name, date, time?, doctor?, laboratory?, address?, result?,\r\n      //   fileUrl?, notes?, status: 'pending'|'done'|'reviewed', color, createdAt\r\n      match /exams/{examId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Hábitos (useHabitsStore) ──────────────────────────────────────\r\n      // /users/{uid}/habits/{habitId}\r\n      //   id, name, description?, color, frequency: 'daily'|'weekly'|'monthly',\r\n      //   weekdays?: list<int>, dayOfMonth?: int, createdAt, archived: bool\r\n      match /habits/{habitId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/habitLogs/{logId}\r\n      //   id, habitId, date, completed: bool, createdAt\r\n      match /habitLogs/{logId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Rotina (useRoutineStore) ─ 4 subcollections ───────────────────\r\n      // /users/{uid}/tasks/{taskId}\r\n      //   id, title, notes?, date, time?: 'HH:mm', priority: 'low'|'medium'|'high',\r\n      //   done: bool, createdAt, completedAt?\r\n      match /tasks/{taskId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/recurringTasks/{taskId}\r\n      //   id, title, notes?, frequency: 'daily'|'weekly'|'monthly',\r\n      //   weekdays?: list<int>, dayOfMonth?: int, time?: 'HH:mm', priority,\r\n      //   lastDone?, nextDue, active: bool, createdAt\r\n      match /recurringTasks/{taskId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/pendingItems/{itemId}\r\n      //   id, title, notes?, priority, createdAt\r\n      match /pendingItems/{itemId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/routineSlots/{slotId}\r\n      //   id, time, endTime?, title, weekdays: list<int>, color?\r\n      match /routineSlots/{slotId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Calendário (useCalendarStore) ─────────────────────────────────\r\n      // /users/{uid}/calendarEvents/{eventId}\r\n      //   id, title, date, startTime, endTime?, allDay?: bool,\r\n      //   color, notes?, taskId?, plannerId?, createdAt\r\n      match /calendarEvents/{eventId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Finanças (useFinanceStore) ─ 7 subcollections ────────────────\r\n      // /users/{uid}/financialAccounts/{accountId}\n      //   id, name, roles: list<'receiving'|'payment'>, createdAt, updatedAt\n      match /financialAccounts/{accountId} {\n        allow read, write: if owns(uid);\n      }\n\n      // /users/{uid}/transactions/{txId}\n      //   id, title, amount: int (centavos), type: 'income'|'expense',\r\n      //   date, category, notes?, fixedBillId?, createdAt\r\n      match /transactions/{txId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/fixedBills/{billId}\r\n      //   id, title, amount, category, dayOfMonth: int 1..31,\r\n      //   notes?, active: bool, createdAt\r\n      match /fixedBills/{billId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/subscriptions/{subId}\r\n      //   id, name, amount, billingCycle: 'monthly'|'yearly'|'weekly',\r\n      //   category, nextBilling: date, active: bool, notes?, createdAt\r\n      match /subscriptions/{subId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/creditCards/{cardId}\r\n      //   id, name, limit, closingDay: int, dueDay: int, color, createdAt\r\n      match /creditCards/{cardId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/installments/{installmentId}\r\n      //   id, title, totalAmount, installmentAmount,\r\n      //   totalInstallments: int, currentInstallment: int,\r\n      //   cardId, category, notes?, createdAt\r\n      match /installments/{installmentId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/financialGoals/{goalId}\r\n      //   id, title, targetAmount, currentAmount, deadline?, color,\r\n      //   notes?, icon?, createdAt\r\n      match /financialGoals/{goalId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/goalDeposits/{depositId}\r\n      //   id, goalId, amount: int (signed — negativo = retirada),\r\n      //   date, notes?, createdAt\r\n      match /goalDeposits/{depositId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n      // /users/{uid}/savingsBoxes/{boxId}\r\n      //   id, name, targetAmount, currentAmount, color, deadline?, notes?, createdAt\r\n      match /savingsBoxes/{boxId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n\r\n      // ─── Lixeira (useTrashStore) ─ capped em 100 itens no cliente ──────\r\n      // /users/{uid}/trashItems/{trashId}\r\n      //   id, type: string, label, detail?, deletedAt: int (ms epoch),\r\n      //   originalModule: string, data: map (payload arbitrário)\r\n      match /trashItems/{trashId} {\r\n        allow read, write: if owns(uid);\r\n      }\r\n    }\r\n\r\n    // ─── Coleções administrativas globais ────────────────────────────────────\r\n    // /app/admin/users/{uid}          — manifest de cada usuária (a própria escreve só o seu)\r\n    // /app/admin/auditLogs/{logId}    — só admina lê/escreve\r\n    // /app/admin/coupons/{couponId}   — admina escreve; qual quer usina lê\r\n    // /app/admin/announcements/{id}   — admina escreve; qual quer lê\r\n    // /app/admin/plans/{planId}       — admina escreve; qual quer lê\r\n    // /app/admin/admin_emails/{email} — admina escreve; qual quer lê (lista de adminas por e-mail)\r\n    match /app/admin/users/{uid} {\r\n      // Cada usinária cria/atualiza só o seu próprio doc de manifest.\r\n      // Admina lê todos (para o painel).\r\n      allow read: if isAdmin();\r\n      allow create, update: if isSignedIn() && request.auth.uid == uid;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /app/admin/auditLogs/{logId} {\r\n      allow read, write: if isAdmin();\r\n    }\r\n\r\n    match /app/admin/coupons/{couponId} {\r\n      allow read: if isSignedIn();\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    match /app/admin/announcements/{announcementId} {\r\n      allow read: if isSignedIn();\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    match /app/admin/plans/{planId} {\r\n      allow read: if isSignedIn();\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    match /app/admin/admin_emails/{emailDoc} {\r\n      allow read: if isSignedIn();\r\n      allow write: if isAdmin();\r\n    }\r\n\r\n    // Nega tudo o que não for /users/{uid}/... explicitamente.\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore/firestore.rules"}]},"createTime":"2026-08-30T01:25:02.379903Z","metadata":{"services":["cloud.firestore"]}}
