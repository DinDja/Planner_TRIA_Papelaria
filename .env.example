# URL pública usada pela InfinitePay para retorno e webhook.
# Em produção, use HTTPS e não inclua barra no final.
APP_URL=http://localhost:3000

# Sua InfiniteTag, com ou sem o caractere $.
INFINITEPAY_HANDLE=sua_infinite_tag

# Segredo aleatório usado para assinar o identificador do pedido. Gere um valor
# diferente em produção (ex.: `openssl rand -base64 32`).
PAYMENT_SIGNING_SECRET=substitua_por_um_segredo_aleatorio

# Identificador público necessário para validar a sessão Firebase no servidor.
FIREBASE_PROJECT_ID=teste-3637d
