# URL pública usada pela InfinitePay para retorno e webhook.
# Em produção, use HTTPS e não inclua barra no final.
APP_URL=http://localhost:3000

# Sua InfiniteTag, com ou sem o caractere $.
INFINITEPAY_HANDLE=sua_infinite_tag

# Firebase Admin. Em ambientes Google com Application Default Credentials,
# apenas FIREBASE_PROJECT_ID é necessário.
FIREBASE_PROJECT_ID=teste-3637d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE\n-----END PRIVATE KEY-----\n"
